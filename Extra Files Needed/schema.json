{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "marks": { "type": "integer" },
          "age": { "type": "integer" },
          "email": { "type": "string", "format": "email" }
        },
        "required": ["name", "marks", "age", "email"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "Address": {
            "type": "object",
            "properties": {
              "first": { "type": "string" },
              "second": { "type": "string" }
            },
            "required": ["first", "second"],
            "additionalProperties": false
          },
          "Grade": { "type": "string" },
          "ID": { "type": "integer" },
          "Subject": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["Address", "Grade", "ID", "Subject"],
        "additionalProperties": false
      }
    ]
  }
}
